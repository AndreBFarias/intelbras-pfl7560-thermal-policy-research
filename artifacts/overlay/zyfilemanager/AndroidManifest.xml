<?xml version="1.0" encoding="utf-8"?>
<!-- Sobreposicao (RRO) Dracula do gerenciador de arquivos do fabricante (bloco 16A). So recursos,
     sem codigo. Nao estatica: cmd overlay enable com.pfl7560.tema.zyfilemanager (doc 48). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.pfl7560.tema.zyfilemanager">
    <overlay android:targetPackage="com.newlink.filemanager" android:priority="1" />
    <application android:hasCode="false" />
</manifest>

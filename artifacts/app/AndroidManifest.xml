<?xml version="1.0" encoding="utf-8"?>
<!-- App "PFL7560" (bloco 9C): dois icones na lista de apps do projetor e (bloco 16B) o descanso
     de tela MeowCast. Nenhuma permissao pedida: o pedido de verificacao vai para a pasta privada do
     proprio app; o BIND_DREAM_SERVICE do descanso e a permissao que SO o sistema tem para ligar o
     servico (atributo do service, nao uses-permission). versionCode/versionName
     e minSdk/targetSdk entram pelo aapt2 link (ver build.sh). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.pfl7560.verificar">

    <application
        android:label="@string/app_nome"
        android:icon="@mipmap/ic_verificar"
        android:allowBackup="false"
        android:theme="@style/Tema">

        <activity
            android:name=".VerificarActivity"
            android:label="@string/verificar_nome"
            android:icon="@mipmap/ic_verificar"
            android:banner="@drawable/banner_verificar"
            android:exported="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WifiActivity"
            android:label="@string/wifi_nome"
            android:icon="@mipmap/ic_wifi"
            android:banner="@drawable/banner_wifi"
            android:exported="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Visor das telas da suite (bloco 29): quem abre e o suite.sh (root, "am start -n"), por
             isso nao e exportado; tarefa propria (taskAffinity) para nao se misturar com o icone
             Verificar; singleTask: cada tela nova chega por onNewIntent, sem fechar e abrir. -->
        <activity
            android:name=".Visor"
            android:theme="@style/TemaVisor"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.pfl7560.verificar.visor"
            android:excludeFromRecents="true" />

        <!-- Descanso de tela MeowCast (bloco 16B). Quem aponta para ele e o suite-boot.sh, por
             screensaver_components. Sem atividade de configuracao. -->
        <service
            android:name=".Descanso"
            android:label="@string/descanso_nome"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

    </application>
</manifest>

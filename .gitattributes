firmware/*.zip filter=lfs diff=lfs merge=lfs -text

# Artefatos BYTE-EXATOS: o md5 destes arquivos e o contrato do projeto.
# `make check` valida 6 deles, e o INI_MD5_OK do pendrive-autorun/newlink_update.sh
# e um GATE -- md5 divergente faz o autorun RECUSAR aplicar o fix.
# Conteudo mistura ASCII, chines GBK e mojibake latin-1, e o trailing whitespace
# faz parte dos bytes originais do vendor.
#
# `-text`      : impede normalizacao de EOL pelo git.
# `byte-exact` : atributo consumido pelo pre-commit (core.hookspath) para NAO
#                aplicar auto-fix de whitespace/newline final nestes arquivos.
#                Sem este marcador o hook removeu whitespace de 88 linhas dos
#                ZYCustom.ini e derrubou o md5 (incidente de 2026-07-29, doc 34).
artifacts/ZYCustom*             -text byte-exact
# Referencias do modelo SEM USB-C (NOTYPEC, V1.0.0.1), do firmware de 2026-10-20 (zip de
# PFL7560.bin md5 89f82720067779fdaae5fc51c1c1ea4e, vendor extraido; doc 42). Copias exatas:
#   artifacts/ZYCustom.ini.NOTYPEC.STOCK  ed3f314ca89698cb057a74ef64dca38e (/vendor/etc/ZYCustom.ini)
#   artifacts/build.prop.NOTYPEC.STOCK    f5b24c1db546dcfb4340f485bf841c8e (/vendor/build.prop)
# e o corrigido dele, gerado pelo kit (secoes termicas sobre o de fabrica dele):
#   artifacts/ZYCustom_390.NOTYPEC.ini    bdf5c4640596d1b2f2fb7f62fbadd6e3
# O primeiro e o terceiro casam em artifacts/ZYCustom*; o segundo em artifacts/*.STOCK abaixo.
pendrive-autorun/ZYCustom.ini   -text byte-exact
# ASCII PURO obrigatorio: rodam no shell do projetor (/vendor/bin/sh) e vivem
# em FAT32, onde acento pt-BR vira mojibake ou quebra o parser. O proprio
# cabecalho dos dois declara a convencao; sem byte-exact o auto-fix de
# acentuacao do pre-commit os acentuaria.
pendrive-autorun/newlink_update.sh  -text byte-exact
pendrive-autorun/LEIA-ME.txt        -text byte-exact
artifacts/*.STOCK               -text byte-exact
artifacts/*.MOD                 -text byte-exact
artifacts/historico/perfis/*    -text byte-exact
# Kit universal de pendrive (bloco 5): o md5 de CADA arquivo esta numa lista
# embutida no newlink_update.sh, que aborta antes de escrever se algum divergir.
# Os PNG e o lvdsctl sao binarios; o cor.sh e ASCII puro como o autorun.
pendrive-autorun/cor.sh             -text byte-exact
pendrive-autorun/lvdsctl            -text byte-exact
pendrive-autorun/nl_camcheck        -text byte-exact
# bloco 9A: gerador de telas (ARM) e as fontes IBM Plex (OFL) que ele usa; binarios, no md5 do kit
pendrive-autorun/nl_tela            -text byte-exact
pendrive-autorun/fontes/*           -text byte-exact
pendrive-autorun/kit/*.png          -text byte-exact
# Suite de verificacao (bloco 9B): ASCII puro como o autorun; o md5 de cada um esta nas
# listas embutidas (KIT_LISTA, SUITE_LISTA, SUITE_MD5), entao nenhum byte pode mudar.
pendrive-autorun/suite.sh           -text byte-exact
pendrive-autorun/suite-boot.sh      -text byte-exact
pendrive-autorun/suite-pedido.sh    -text byte-exact
pendrive-autorun/pfl7560-suite.rc   -text byte-exact
# Quadros crus da camera interna (bloco 7, YUYV 640x480): sem byte 0 nem fim de linha,
# o git os toma por texto; byte-exact impede que o pre-commit "conserte" algum byte.
tests/fixtures/camera/*.yuyv        -text byte-exact
# App "PFL7560" (bloco 9C): APK assinado (md5 na KIT_LISTA), chave de assinatura estavel e a copia do kit
artifacts/app/pfl7560.apk           -text byte-exact
artifacts/app/assinatura.keystore   -text byte-exact
artifacts/app/res/**/*.png          -text byte-exact
artifacts/home/pfl7560-home.apk     -text byte-exact
artifacts/home/assinatura.keystore  -text byte-exact
artifacts/home/previa/*.png         -text byte-exact
artifacts/tema/*.png                -text byte-exact
artifacts/tema/previa/*.png         -text byte-exact
pendrive-autorun/pfl7560.apk        -text byte-exact
pendrive-autorun/pfl7560-home.apk   -text byte-exact
# texto que acompanha o nosso .bin no pendrive (--com-firmware, bloco 9C): ASCII puro, copiado byte a byte
firmware/LEIA-ME-nosso-NAO-GRADUADO.txt  -text byte-exact
artifacts/overlay/apk/*.apk         -text byte-exact
artifacts/overlay/assinatura.keystore  -text byte-exact
artifacts/overlay/*/res/**/*.png    -text byte-exact
artifacts/overlay/previa/*.png      -text byte-exact
artifacts/tema/marca/*             -text byte-exact
# Bloco 14: copias de artifacts/overlay/apk/ e artifacts/tema/marca/ no kit (geradas por tests/atualizar-md5-kit.sh; md5 na KIT_LISTA)
pendrive-autorun/overlay/*.apk      -text byte-exact
pendrive-autorun/marca/*            -text byte-exact

[Desktop Entry]
Version=1.0
Type=Application
Name=Corrigir PFL7560
Name[pt_BR]=Corrigir PFL7560
Comment=Aplica/confere a correcao termica do projetor Intelbras PFL7560 via adb
Comment[pt_BR]=Aplica/confere a correção térmica do projetor Intelbras PFL7560
Exec=bash -c 'cd "$(dirname "$(readlink -f "%k")")" && exec ./pfl7560-menu.sh'
Terminal=true
Icon=video-display
Categories=Utility;System;
